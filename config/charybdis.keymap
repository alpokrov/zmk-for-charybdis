#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3          &kp N4            &kp N5         &kp N6         &kp N7       &kp N8     &kp N9   &kp N0     &kp BACKSLASH
&kp TAB         &kp Q   &kp W   &kp E           &kp R             &kp T          &kp Y          &kp U        &kp I      &kp O    &kp P      &kp LEFT_BRACE
&kp LEFT_ALT    &kp A   &kp S   &kp D           &kp F             &kp G          &kp H          &kp J        &kp K      &kp L    &kp SEMI   &kp APOS
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C           &kp V             &kp B          &kp N          &kp M        &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_SHIFT
                                &kp LEFT_SHIFT  &kp LEFT_COMMAND  &mkp MCLK      &kp RETURN     &lt 1 SPACE
                                                &kp LCTRL         &lt 2 SPACE    &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        Numbers {
            bindings = <
&kp TILDE       &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE       &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &none          &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp RIGHT_BRACE
&kp LEFT_ALT    &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none          &kp BACKSLASH  &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LEFT_SHIFT  &kp NUMBER_9     &kp NUMBER_0  &kp MINUS     &kp EQUAL     &none          &none          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                               &kp LEFT_WIN  &kp SPACE     &trans         &sl 2          &none
                                                             &none         &none          &sl 0
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none           &mkp LCLK  &mkp RCLK     &mkp MCLK     &none         &none
&bootloader  &none         &mkp RCLK     &mo 0         &mkp LCLK  &none         &studio_unlock  &mkp LCLK  &none         &mkp RCLK     &none         &bootloader
                                         &none         &none      &none         &kp ESCAPE      &kp SPACE
                                                       &none      &none         &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
